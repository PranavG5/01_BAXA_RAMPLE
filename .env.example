# ---------------------------------------------------------------------------
# Rample Video Studio - environment variables
# Copy to .env.local for local dev; add the same keys in Vercel > Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Supabase (Postgres + Auth + private Storage). Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude (brief, storyboard, router, photo tagging, QA scoring)
ANTHROPIC_API_KEY=
# Optional overrides. Default for both is claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_QA_MODEL=claude-sonnet-5-5

# Video providers (image-to-video). Keys stay server side; Claude never sees them.
# Higgsfield: console.higgsfield.ai -> API key id + secret (or HIGGSFIELD_CREDENTIALS=id:secret)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Pika developer API: dev.pika.art/keys
PIKA_API_KEY=
# Optional: Standard Webhooks signing secrets (whsec_...). Webhooks are only "nudges";
# the app always re-reads job status from the provider, so these are recommended, not required.
# HIGGSFIELD_WEBHOOK_SECRET=
# PIKA_WEBHOOK_SECRET=

# Assembly (Shotstack Edit API). Use SHOTSTACK_ENV=stage with a sandbox key (watermarked, free).
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1
# SHOTSTACK_FONT=Open Sans

# Voiceover (ElevenLabs)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Licensed background music (public or signed MP3 URLs). Either one track:
# MUSIC_URL=https://.../track.mp3
# or several, picked by the storyboard's mood word:
# MUSIC_TRACKS=[{"mood":"upbeat","url":"https://.../upbeat.mp3","license":"Artlist #123"},{"mood":"chill","url":"https://.../chill.mp3","license":"..."}]

# App
# Public https URL of the deployment, used for provider/Shotstack callbacks. On Vercel this
# falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# APP_URL=https://your-app.vercel.app
# Comma-separated emails that get the Rample staff pages (review queue, registry, metrics).
STAFF_EMAILS=
# Secret for the cron sweep (Vercel sends it as a Bearer token automatically when set).
CRON_SECRET=
# Default per-video credit cap for new businesses (1 credit = $0.01).
# DEFAULT_CREDIT_CAP=300

# Set to "mock" to simulate video models, voiceover and assembly locally with ffmpeg.
# Claude still runs; no video/voice/assembly credits are spent.
# MEDIA_MODE=mock
