# ---------------------------------------------------------------------------
# Rample Video Studio - environment variables
# Copy to .env.local for local dev; add the same keys in Vercel > Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Storage: Supabase. On Vercel all three are required, or uploads vanish (each server
# instance has its own temporary /tmp).
# Supabase > Connect > "Transaction pooler" string, with your database password filled in:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase > Project Settings > API: the project URL and a secret key (server only, never publish it):
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# Photos and videos go to private Storage buckets "assets" and "media", created on first use.
# Without these the app uses an embedded Postgres (PGlite) plus files in DATA_DIR
# (default ./.data). Fine on your own machine.
# DATA_DIR=./.data

# Claude (brief, storyboard, router, photo tagging, QA scoring)
ANTHROPIC_API_KEY=
# Optional overrides. Default for both is claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_QA_MODEL=claude-sonnet-5-5

# Video providers (image-to-video). Keys stay server side; Claude never sees them.
# Higgsfield: console.higgsfield.ai -> API key id + secret. Both are required.
# (Or one variable: HIGGSFIELD_CREDENTIALS=id:secret. HF_KEY / HF_API_KEY + HF_API_SECRET also work.)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Pika developer API: dev.pika.art/keys
PIKA_API_KEY=
# Optional: Standard Webhooks signing secrets (whsec_...). Webhooks are only "nudges";
# the app always re-reads job status from the provider, so these are recommended, not required.
# HIGGSFIELD_WEBHOOK_SECRET=
# PIKA_WEBHOOK_SECRET=

# Assembly (Shotstack Edit API). Optional: without a key the app assembles videos itself with
# ffmpeg (same scenes, text, logo, voiceover and music; simpler text styling).
# Use SHOTSTACK_ENV=stage with a sandbox key (watermarked, free).
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1
# SHOTSTACK_FONT=Open Sans

# Voiceover (ElevenLabs). Optional: without it, videos have captions and no spoken voiceover.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Licensed background music (public or signed MP3 URLs). Either one track:
# MUSIC_URL=https://.../track.mp3
# or several, picked by the storyboard's mood word:
# MUSIC_TRACKS=[{"mood":"upbeat","url":"https://.../upbeat.mp3","license":"Artlist #123"},{"mood":"chill","url":"https://.../chill.mp3","license":"..."}]

# App
# Public https URL of the deployment. Video providers and Shotstack fetch your photos and
# clips from it, and send callbacks to it. On Vercel this
# falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# APP_URL=https://your-app.vercel.app
# Login is one hardcoded admin account (test@rample.ai, see src/lib/server/auth.ts).
# Secret used to sign the login cookie and file links. Optional but recommended.
# SESSION_SECRET=
# Secret for the cron sweep (Vercel sends it as a Bearer token automatically when set).
CRON_SECRET=
# Default per-video credit cap for new businesses (1 credit = $0.01). High on purpose: model choice is quality first.
# DEFAULT_CREDIT_CAP=5000

# Set to "mock" to simulate video models, voiceover and assembly locally with ffmpeg.
# Claude still runs; no video/voice/assembly credits are spent.
# MEDIA_MODE=mock
